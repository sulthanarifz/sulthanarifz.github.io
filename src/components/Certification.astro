<!-- Logic Rendering Scroll & Transition -->
<style>
  /* 
    State awal elemen diturunkan dan disembunyikan.
    Kita beralih dari 'animation' menjadi 'transition' murni agar bisa dipicu oleh penambahan class.
  */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  /* State akhir ketika class diinjeksi oleh JS */
  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Eksekusi ketika DOM sudah siap (Penting di Astro agar script tidak jalan prematur)
  document.addEventListener("DOMContentLoaded", () => {
    // Intersection Observer bertugas memantau koordinat elemen tanpa memblokir thread utama
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Menambahkan class is-visible ketika masuk layar
          entry.target.classList.add('is-visible');
          
          // (Opsional) Menghentikan pantauan setelah elemen muncul agar animasi tidak berulang saat scroll naik
          obs.unobserve(entry.target); 
        }
      });
    }, { 
      threshold: 0.1, 
      rootMargin: "0px 0px -50px 0px" // Trigger ditarik 50px dari bawah layar
    });

    // Tempelkan radar pantauan ke semua elemen yang memiliki class reveal-on-scroll
    document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
      observer.observe(el);
    });
  });
</script>