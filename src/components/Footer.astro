<!-- Footer Section -->
<footer class="py-12 bg-[#151515] border-t border-white/5 text-gray-400 text-sm">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    
    <div class="flex flex-col items-center md:items-start gap-1">
      <p class="font-display text-white tracking-wide uppercase">
        Sulthan Arif Zhafran
      </p>
      <p class="text-xs text-gray-500">
        © {new Date().getFullYear()} All rights reserved.
      </p>
    </div>

    <!-- Back to Top -->
    <div class="flex items-center gap-6">
      <button 
        id="back-to-top" 
        class="hover:text-white transition-colors text-xs uppercase tracking-wider font-medium cursor-pointer bg-transparent border-none p-0 text-inherit">
        Back to Top ↑
      </button>
    </div>

  </div>
</footer>

<script>
      function initBackToTop() {
        const backToTopBtn = document.getElementById('back-to-top');
        if (backToTopBtn) {
          backToTopBtn.replaceWith(backToTopBtn.cloneNode(true));
          const newBtn = document.getElementById('back-to-top');
          
          newBtn?.addEventListener('click', () => {
            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });
          });
        }
      }

      document.addEventListener('DOMContentLoaded', initBackToTop);
      document.addEventListener('astro:page-load', initBackToTop);
</script>